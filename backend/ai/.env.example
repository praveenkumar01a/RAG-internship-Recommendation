# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:1.5b

# Optional: PostgreSQL / Supabase with pgvector
# (If not configured or unreachable, the system automatically uses local in-memory cosine vector search)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=postgres
